# Postgres (host-side values, used by alembic run from backend/)
# docker-compose overrides these for containers to point at the db service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_job_assistant
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_job_assistant

# LLM (BYOK) — Gemini Flash is the default provider
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-2.5-flash
# Embeddings — gemini-embedding-001 defaults to 3072 dims; EMBEDDING_DIMENSIONS=768
# truncates via the API's dimensions param to match the pinned vector(768) columns.
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Job sources (fill in as you enable connectors)
# Adzuna keys (free) enable job search: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Max Adzuna HTTP calls per search run (sub-queries × pages; default 4 covers a
# two-pass search with pagination). Adzuna free tier: 25/min, 250/day.
MAX_ADZUNA_CALLS_PER_RUN=4
# Apify token enables the scraper source (LinkedIn jobs actor — paid per result
# on your Apify plan, ~$1/1000 results): https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Cap on billed results per Apify actor run (limitPerSource); default 250
# sits above the schema request cap (100) as a guard. See the ApifyJobSource docstring.
MAX_APIFY_RESULTS_PER_RUN=250
# Runs stuck in pending/running longer than this are marked failed by the
# start_search sweeper, releasing the one-active-run-per-(profile,source) lock.
MAX_RUN_AGE_MINUTES=30

# Resume uploads (files on disk, metadata in DB)
UPLOADS_DIR=./data/uploads
RESUME_MAX_UPLOAD_MB=10

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Profile extraction
EXTRACTION_MAX_CHARS=20000

# Outbound retries — shared by LLM calls and job-source HTTP calls (429/5xx/transport).
# Exponential backoff with jitter; a provider's Retry-After header takes precedence.
# The defaults fit the Gemini free tier; raise the base delay if you hit 429s often.
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_S=1.0

# Matching — hybrid final_score (#37):
#   match_weight_vector * cosine similarity
#   + match_weight_skill * top-skill hit fraction
#   + match_weight_recency * exp(-days_since_posting / MATCH_RECENCY_DECAY_DAYS)
#   + match_weight_salary * salary-band-fit (1.0 unknown, 0.5 without a preference band)
#   + match_weight_role_fit * LLM role_fit/10 + match_weight_company_fit * LLM company_fit/10.
# The five weights must sum to 1.0 (±0.01; startup fails otherwise). Postings without
# an embedding are scored on skill+recency+salary renormalized instead of excluded.
# LLM re-rank applies to the top rerank_top_n postings without a rationale, by
# hybrid score (not cosine alone). The dashboard's priority slider (#11) still
# overrides only the role/company split per profile at read time.
# MATCH_SKILL_SIGNAL_SKILLS caps how many top profile skills feed the skill signal.
RERANK_TOP_N=10
MATCH_WEIGHT_VECTOR=0.35
MATCH_WEIGHT_SKILL=0.25
MATCH_WEIGHT_RECENCY=0.15
MATCH_WEIGHT_ROLE_FIT=0.15
MATCH_WEIGHT_COMPANY_FIT=0.05
MATCH_WEIGHT_SALARY=0.05
MATCH_RECENCY_DECAY_DAYS=14
MATCH_SKILL_SIGNAL_SKILLS=25

# Cross-source dedupe (issue #38) — postings found by the same resolved country and
# normalized company with a pg_trgm title similarity at or above this threshold are
# grouped under one canonical posting (freshest posted_at, richest description, and a
# merged source_urls list); matches collapse to the canonical. 1.0 = exact titles only.
POSTING_DEDUPE_SIMILARITY=0.92

# Freshness — postings closed or expired (source-reported) are excluded from
# matches and search results; without a source-reported expiry, a posting is
# stale after this many days since posting and is excluded too.
STALE_POSTING_DAYS=45

# Seniority derivation (issue #32) — when the user hasn't set a seniority, it is
# derived deterministically from parsed years of experience using these band
# thresholds (YOE < next band's threshold maps down):
#   0–1 → junior, 2–4 → mid, 5–7 → senior, 8–11 → staff, 12+ → principal.
SENIORITY_BAND_MID=2
SENORITY_BAND_SENIOR=5
SENORITY_BAND_STAFF=8
SENORITY_BAND_PRINCIPAL=12
