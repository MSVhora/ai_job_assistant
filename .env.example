# Postgres (host-side values, used by alembic run from backend/)
# docker-compose overrides these for containers to point at the db service.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_job_assistant
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_job_assistant

# LLM (BYOK) — Gemini Flash is the default provider
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-2.5-flash
# Embeddings — gemini-embedding-001 defaults to 3072 dims; EMBEDDING_DIMENSIONS=768
# truncates via the API's dimensions param to match the pinned vector(768) columns.
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Job sources (fill in as you enable connectors)
# Adzuna keys (free) enable job search: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Apify token enables the scraper source (LinkedIn jobs actor — paid per result
# on your Apify plan, ~$1/1000 results): https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Resume uploads (files on disk, metadata in DB)
UPLOADS_DIR=./data/uploads
RESUME_MAX_UPLOAD_MB=10

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Profile extraction
EXTRACTION_MAX_CHARS=20000

# Matching — final_score = match_weight_vector * cosine similarity
#   + match_weight_role_fit * LLM role_fit/10 + match_weight_company_fit * company_fit/10.
# LLM re-rank applies to the top rerank_top_n postings without a rationale;
# weights stay here until the priority slider (#11) moves them into preferences.
RERANK_TOP_N=10
MATCH_WEIGHT_VECTOR=0.4
MATCH_WEIGHT_ROLE_FIT=0.4
MATCH_WEIGHT_COMPANY_FIT=0.2
